outputs/*
!outputs/.gitkeep

# Large raw/intermediate/processed artifacts are regenerated locally and not tracked.
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep
Data protocol/
data_protocol/

# Duplicate camera-ready snapshot kept out of the source repo; canonical code is in src/.
Code and config/

